          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/graphql",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"query\": \"query { login(username: \\\"usuario1\\\", password: \\\"1234\\\") { authenticated token message user { id username firstName lastName email avatarUrl } } }\"}"
        }
      }
    },
    {
