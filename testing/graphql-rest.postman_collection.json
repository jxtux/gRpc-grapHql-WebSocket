            "graphql"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"query\": \"query { me(userId: 1) { id username firstName lastName email phone profession description avatarUrl } userRelations(userId: 1) { type status user { id username firstName lastName email avatarUrl } } }\"}"
        }
      }
